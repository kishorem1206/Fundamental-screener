# Fundamental Screener — Environment Variables
# Copy this file to `.env` and fill in the real values. `.env` is
# git-ignored and must never be committed.

# Server
NODE_ENV=development
API_PORT=3002
API_HOST=0.0.0.0

# Database (SAME as Stock Screener — read existing stocks + new FA tables).
# screener:screener is this project's documented local-only Postgres
# convention (see HOW_TO_RUN.md) — change the host/port/credentials if your
# local Postgres differs, and always use a real, non-default password for
# any non-local database.
DATABASE_URL=postgresql://screener:screener@localhost:5434/screener
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=fa:

# LLM (Groq / GPT-OSS 20B) — get a key at https://console.groq.com
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# MinIO (document storage) — local-only defaults; override for any non-local instance.
MINIO_ENDPOINT=localhost:9092
MINIO_ACCESS_KEY=screener
MINIO_SECRET_KEY=screener123
MINIO_BUCKET=fa-documents
MINIO_SECURE=false

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=true

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Reports directory
REPORTS_DIR=./reports

# Screener.in login (optional) — fill in to fetch the FULL "Key Points"
# commentary (Brand Value, Revenue Mix, Clientele, etc.), not just the free
# preview's first section. Leave blank to keep scraping anonymously.
SCREENER_EMAIL=
SCREENER_PASSWORD=

# IndianAPI.in (stock.indianapi.in) — Free plan. Used only for the two
# things not already covered elsewhere: analyst rating distribution
# (/stock_target_price) and market-wide movers (/trending etc.) for the
# Explore page. See Important md files/indianapi.md for the full endpoint
# reference. Get a key at https://indianapi.in
INDIANAPI_KEY=your_indianapi_key_here

# Gemini API key (for fetching live stock prices from Gemini API).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini-3.8-flash
